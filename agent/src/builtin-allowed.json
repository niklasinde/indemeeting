{
  "tools": ["Read", "Grep", "Glob"],
  "mcpPrefix": "mcp__worktime__",
  "alwaysAsk": ["mcp__worktime__send_to_agent"],
  "commands": [
    { "name": "ls", "anyArgs": true },
    { "name": "cat", "anyArgs": true },
    { "name": "head", "anyArgs": true },
    { "name": "tail", "anyArgs": true },
    { "name": "wc", "anyArgs": true },
    { "name": "grep", "anyArgs": true },
    { "name": "pwd", "anyArgs": true },
    { "name": "which", "anyArgs": true },
    { "name": "cd", "anyArgs": true },
    { "name": "jq", "anyArgs": true },
    { "name": "echo", "anyArgs": true },
    { "name": "cut", "anyArgs": true },
    { "name": "tr", "anyArgs": true },
    { "name": "basename", "anyArgs": true },
    { "name": "dirname", "anyArgs": true },
    { "name": "realpath", "anyArgs": true },
    { "name": "stat", "anyArgs": true },
    { "name": "true", "anyArgs": true },
    { "name": "false", "anyArgs": true },
    { "name": "test", "anyArgs": true },
    { "name": "[", "anyArgs": true },
    { "name": "git", "note": "status, log, diff, show, blame, ls-files, ls-tree, rev-parse, rev-list, merge-base, describe, shortlog, show-ref; branch and remote -v listing; grep (not -O); cat-file -p/-t/-s; config reads; no --output" },
    { "name": "gh", "note": "pr view, diff, checks, list, status; api GET without fields" },
    { "name": "rg", "note": "not --pre" },
    { "name": "find", "note": "no -delete, -exec, -ok or -fprint" },
    { "name": "sed", "note": "no -i or -f, no w/W/e" },
    { "name": "awk", "note": "no system, getline, pipes or redirects" },
    { "name": "sort", "note": "no -o or --compress-program" },
    { "name": "uniq", "note": "no output file" },
    { "name": "diff", "note": "no --output" },
    { "name": "file", "note": "not -C" },
    { "name": "date", "note": "showing the date only" },
    { "name": "printf", "note": "not -v" },
    { "name": "env", "note": "without arguments" },
    { "name": "exit", "note": "with a status at most" },
    { "name": "mkdir", "note": "-p, only inside the agent's scratchpad" },
    { "name": "touch", "note": "only inside the agent's scratchpad" },
    { "name": "tee", "note": "-a, only inside the agent's scratchpad" },
    { "name": "cp", "note": "into the agent's scratchpad only" },
    { "name": "mv", "note": "within the agent's scratchpad only" },
    { "name": "rm", "note": "inside the agent's scratchpad only, recursive too" }
  ]
}
